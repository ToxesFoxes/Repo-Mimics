<Project Sdk="Microsoft.NET.Sdk">
  <!-- Optional local overrides (gitignored). Set GameDir to build against the installed game instead of NuGet GameLibs. -->
  <Import Project="TFS_Mimics.local.props" Condition="Exists('TFS_Mimics.local.props')" />

  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <AssemblyName>TFS_Mimics</AssemblyName>
    <RootNamespace>TFS_Mimics</RootNamespace>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <EnableDefaultItems>false</EnableDefaultItems>
    <GameManagedDir Condition="'$(GameDir)' != ''">$(GameDir)\REPO_Data\Managed</GameManagedDir>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="src\**\*.cs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="BepInEx.Analyzers" Version="1.*" PrivateAssets="all" />
    <PackageReference Include="BepInEx.Core" Version="5.*" />
    <PackageReference Include="BepInEx.AssemblyPublicizer.MSBuild" Version="0.4.1" PrivateAssets="all" ExcludeAssets="runtime" />
    <PackageReference Include="Rune580.Mods.Repo.RepoSteamNetworking" Version="0.1.*" PrivateAssets="all" ExcludeAssets="runtime" />
  </ItemGroup>

  <ItemGroup Condition="'$(GameManagedDir)' == ''">
    <PackageReference Include="UnityEngine.Modules" Version="2022.3.62" IncludeAssets="compile" />
    <PackageReference Include="R.E.P.O.GameLibs.Steam" Version="*-*" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup Condition="'$(GameManagedDir)' != ''">
    <Reference Include="$(GameManagedDir)\Assembly-CSharp.dll" Publicize="true" Private="false" />
    <Reference Include="$(GameManagedDir)\UnityEngine*.dll" Private="false" />
    <Reference Include="$(GameManagedDir)\Unity.TextMeshPro.dll" Private="false" />
    <Reference Include="$(GameManagedDir)\Unity.InputSystem.dll" Private="false" />
    <Reference Include="$(GameManagedDir)\Photon*.dll" Private="false" />
    <Reference Include="$(GameManagedDir)\Facepunch.Steamworks.Win64.dll" Private="false" />
    <Reference Include="$(GameManagedDir)\Sirenix.Serialization.dll" Private="false" />
  </ItemGroup>

</Project>
